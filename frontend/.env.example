# Supabase Configuration
# Found in your Supabase project dashboard under Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Express Backend URL
VITE_API_BASE_URL=http://localhost:5001

# Demo Account Credentials (Optional - used for Role Card Autofill on Login page)
VITE_DEMO_PASSWORD=your_demo_password_here
# Optional per-role overrides:
# VITE_DEMO_REGULATOR_PASSWORD=
# VITE_DEMO_INSTITUTION_PASSWORD=
# VITE_DEMO_STUDENT_PASSWORD=
# VITE_DEMO_COMPANY_PASSWORD=

